{
  "expo": {
    "name": "Helper PDF: Reader & Scanner",
    "slug": "helper-pdf-reader",
    "version": "1.0.0",
    "scheme": "helperpdf",
    "orientation": "default",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dkwork.helperpdf",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Helper PDF: Reader & Scanner needs camera access to scan paper documents and convert them to PDF.",
        "NSPhotoLibraryUsageDescription": "Helper PDF: Reader & Scanner needs photo access to import documents and images to PDF.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive_icon.png",
        "backgroundColor": "#6366f1"
      },
      "package": "com.dkwork.helperpdf",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "file",
              "mimeType": "application/pdf"
            },
            {
              "scheme": "content",
              "mimeType": "application/pdf"
            },
            {
              "scheme": "https",
              "mimeType": "application/pdf"
            },
            {
              "scheme": "http",
              "mimeType": "application/pdf"
            }
          ],
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./src/assets/icon.png"
    },
    "plugins": [
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.YOUR_IOS_CLIENT_ID"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          },
          "android": {
            "usesCleartextTraffic": true,
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enableMinifyInReleaseBuilds": true
          }
        }
      ],
      "expo-sharing",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "31024e26-0a1e-4078-9a03-4536935b9a5c"
      }
    },
    "owner": "upschelper"
  }
}
